{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://partybox.example/schemas/C02/pack.schema.json",
  "title": "C02 historical biography pipeline sample; not current game content",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "buildDate", "sourceSnapshot", "complete", "rows"],
  "definitions": {
    "nonemptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "date": {"type": "string", "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"}
  },
  "properties": {
    "mode": {"const": "historical-sample"},
    "buildDate": {"$ref": "#/definitions/date"},
    "sourceSnapshot": {"$ref": "#/definitions/date"},
    "complete": {"const": false},
    "rows": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "birthDate", "recordedDeathDate", "status", "sitelinks", "portrait", "fact", "factStatus"],
        "properties": {
          "id": {"$ref": "#/definitions/nonemptyString"},
          "name": {"$ref": "#/definitions/nonemptyString"},
          "birthDate": {"$ref": "#/definitions/date"},
          "recordedDeathDate": {"anyOf": [{"$ref": "#/definitions/date"}, {"type": "null"}]},
          "status": {"type": "null"},
          "sitelinks": {"type": "null"},
          "portrait": {"type": "null"},
          "fact": {"type": "null"},
          "factStatus": {"const": "unverified"}
        }
      }
    }
  }
}
