{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://partybox.example/schemas/C03/pack.schema.json",
  "title": "C03 historical pageview sample pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "complete",
    "buildDate",
    "requestedPeriod",
    "sourcePeriod",
    "currentMonthVerified",
    "project",
    "access",
    "agent",
    "rows"
  ],
  "properties": {
    "mode": {
      "const": "historical-sample"
    },
    "complete": {
      "const": false
    },
    "buildDate": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "requestedPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "sourcePeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "const": "2020-06-01"
        },
        "end": {
          "const": "2020-06-30"
        }
      }
    },
    "currentMonthVerified": {
      "const": false
    },
    "project": {
      "const": "en.wikipedia"
    },
    "access": {
      "const": "unrecorded-by-source"
    },
    "agent": {
      "const": "unrecorded-by-source"
    },
    "rows": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "a",
          "b",
          "ratio",
          "fact",
          "factStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^historical-(0[1-9]|[12][0-9]|30)$"
          },
          "a": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "article",
              "pageviews"
            ],
            "properties": {
              "article": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                ]
              },
              "pageviews": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "b": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "article",
              "pageviews"
            ],
            "properties": {
              "article": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                ]
              },
              "pageviews": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "ratio": {
            "type": "number",
            "minimum": 1.2,
            "maximum": 3
          },
          "fact": {
            "type": "null"
          },
          "factStatus": {
            "const": "unverified"
          }
        }
      }
    }
  }
}
